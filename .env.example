# ─────────────────────────────────────────────────────────────────────────────
# .env.example — template variabili d'ambiente per sviluppo locale
#
# ISTRUZIONI:
#   cp .env.example .env
#   Modifica .env con i valori reali (mai committare .env nel repo!)
#
# Usato da:
#   - spring-dotenv: carica automaticamente il file .env a runtime in DEV
#   - Docker Compose: env_file: .env nel compose.yaml
# ─────────────────────────────────────────────────────────────────────────────

# ── Ambiente ─────────────────────────────────────────────────────────────────
# DEV | STAGE | PROD
ENV=DEV

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=eu-south-1
AWS_ACCESS_KEY=changeme
AWS_SECRET_KEY=changeme
AWS_BUCKET_NAME=changeme

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme
POSTGRES_SCHEMA=public
